# Ajustes del correo de CJ (no son secretos). La clave de Resend va en Secret Manager: docs/correo.md
# Ponga true solo DESPUÉS de crear el secreto RESEND_API_KEY; con false se envía el correo estándar de Firebase.
EMAIL_ENABLED=true
# Remitente: el dominio (cjclub.eu) tiene que estar verificado en Resend.
EMAIL_FROM=CJ Club <info@cjclub.eu>
# Dirección a la que llegan las respuestas de los clientes (vacío = la del remitente)
EMAIL_REPLY_TO=
APP_URL=https://cjclub.eu
