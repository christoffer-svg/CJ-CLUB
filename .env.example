# Configuración web de Firebase (Consola de Firebase > Configuración del proyecto > Tus apps).
# Estos valores no son secretos: identifican el proyecto. La seguridad la dan las reglas de Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cj-club.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cj-club
VITE_FIREBASE_STORAGE_BUCKET=cj-club.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=default

# Pon "true" para usar el Firebase de pruebas local (npm run emulators)
VITE_USE_EMULATORS=false
