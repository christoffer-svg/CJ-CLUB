rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo entran personas invitadas por CJ: deben tener su ficha en users/{uid}.
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isMember() && me().role == 'admin';
    }

    // Colaboradores asignados en la ficha del cliente que hace la petición
    function isMyPartner(partnerId) {
      return isMember() && 'clientId' in me()
        && partnerId in get(/databases/$(database)/documents/clients/$(me().clientId)).data.contacts.values();
    }

    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // Cada persona solo puede cambiar su idioma y sus favoritos; el rol lo asigna CJ.
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['language', 'favorites'])
            && request.resource.data.language in ['es', 'en']
            && (!('favorites' in request.resource.data)
                || (request.resource.data.favorites is list && request.resource.data.favorites.size() <= 200)));
      allow create, delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || (isMember() && me().clientId == clientId);
      allow write: if isAdmin();
    }

    // Un cliente solo ve los colaboradores asignados a él (lectura de uno en uno)
    match /partners/{id} {
      allow get: if isAdmin() || isMyPartner(id);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /generalContacts/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /places/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /deals/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Ajustes generales, p. ej. settings/tipOfTheWeek
    match /settings/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
