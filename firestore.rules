rules_version = '2';


// Reglas de seguridad de Firestore de CJ Club.
// Principio: todo está denegado salvo lo que se permite expresamente aquí.
// Las funciones de servidor (carpeta functions/) usan permisos de administrador y no pasan por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quién hace la petición ----------

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Ficha users/{uid} de quien hace la petición
    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    // Persona invitada por CJ: tiene sesión y ficha en users/
    function isMember() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function isAdmin() {
      return isMember() && me().role == 'admin';
    }

    function isClient() {
      return isMember() && me().role == 'client' && me().clientId is string;
    }

    // Negocio colaborador invitado por CJ, vinculado a un lugar
    function isBusiness() {
      return isMember()
        && me().role == 'business'
        && me().placeId is string
        && me().placeId.size() > 0
        && me().placeId.size() <= 200;
    }

    function myPlaceId() {
      return me().placeId;
    }

    function placeOf(id) {
      return get(/databases/$(database)/documents/places/$(id)).data;
    }

    // Si el rol es negocio, tiene que quedar vinculado a un lugar que existe
    function businessLinked() {
      return request.resource.data.role != 'business'
        || (request.resource.data.placeId is string
            && request.resource.data.placeId.size() > 0
            && request.resource.data.placeId.size() <= 200
            && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId)));
    }

    // Colaborador asignado en el mapa contacts de la ficha del cliente
    function isMyPartner(partnerId) {
      return isClient()
        && partnerId in get(/databases/$(database)/documents/clients/$(me().clientId)).data.contacts.values();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- users/{uid} ----------
    match /users/{uid} {
      // Cada persona lee solo su ficha; el equipo de CJ, todas
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      // Un cliente solo puede cambiar su idioma y sus favoritos
      allow update: if isClient() && request.auth.uid == uid
        && changedKeys().hasOnly(['language', 'favorites'])
        && request.resource.data.language in ['es', 'en', 'nl', 'sv', 'de', 'fr']
        && (!('favorites' in request.resource.data)
            || (request.resource.data.favorites is list && request.resource.data.favorites.size() <= 200));

      // Un negocio solo puede cambiar su idioma
      allow update: if isBusiness() && request.auth.uid == uid
        && changedKeys().hasOnly(['language'])
        && request.resource.data.language in ['es', 'en', 'nl', 'sv', 'de', 'fr'];

      // El equipo de CJ gestiona las fichas, pero nadie puede cambiarse su propio rol ni borrarse a sí mismo
      allow update: if isAdmin()
        && request.resource.data.role in ['admin', 'client', 'business']
        && businessLinked()
        && (uid != request.auth.uid || !changedKeys().hasAny(['role']));
      allow create: if isAdmin() && uid != request.auth.uid
        && request.resource.data.role in ['admin', 'client', 'business']
        && businessLinked();
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // ---------- clients/{clientId} ----------
    match /clients/{clientId} {
      allow read: if isAdmin() || (isClient() && me().clientId == clientId);
      allow write: if isAdmin();
    }

    // ---------- partners/{id} ----------
    // Un cliente solo lee, de uno en uno, los colaboradores asignados a él; nunca la lista completa
    match /partners/{id} {
      allow get: if isAdmin() || isMyPartner(id);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------- partnerCategories/{id} ----------
    // Servicios de los colaboradores (abogado, piscina, y los que CJ añada).
    // Los clientes los leen para ver el nombre. El negocio no los necesita.
    // Solo el equipo de CJ los cambia. Borrar uno que está en uso lo impide el panel.
    match /partnerCategories/{id} {
      allow read: if isAdmin() || isClient();
      allow write: if isAdmin();
    }

    // ---------- Contenido común: los socios lo leen; el negocio no ----------
    match /generalContacts/{id} {
      allow read: if isAdmin() || isClient();
      allow write: if isAdmin();
    }

    match /places/{id} {
      allow get: if isAdmin() || isClient() || (isBusiness() && id == myPlaceId());
      allow list: if isAdmin() || isClient();
      allow write: if isAdmin();
    }

    // Texto de un descuento publicado por el negocio. Sin campos de más.
    function dealTextOk() {
      return request.resource.data.keys().hasOnly([
          'title', 'conditions_es', 'conditions_en', 'discountLabel', 'code', 'active', 'order',
          'placeId', 'businessName', 'description_es', 'description_en', 'validFrom', 'validUntil',
          'source', 'createdByUid', 'hiddenByAdmin'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.discountLabel is string
        && request.resource.data.discountLabel.size() > 0
        && request.resource.data.discountLabel.size() <= 40
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 40
        && request.resource.data.conditions_es is string
        && request.resource.data.conditions_es.size() <= 2000
        && request.resource.data.conditions_en is string
        && request.resource.data.conditions_en.size() <= 2000
        && request.resource.data.description_es is string
        && request.resource.data.description_es.size() <= 2000
        && request.resource.data.description_en is string
        && request.resource.data.description_en.size() <= 2000
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.businessName.size() <= 200
        && request.resource.data.validFrom is string
        && (request.resource.data.validFrom.size() == 0 || request.resource.data.validFrom.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.validUntil is string
        && (request.resource.data.validUntil.size() == 0 || request.resource.data.validUntil.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && (request.resource.data.validFrom.size() == 0
            || request.resource.data.validUntil.size() == 0
            || request.resource.data.validFrom <= request.resource.data.validUntil)
        && request.resource.data.active is bool
        && request.resource.data.order is number
        && request.resource.data.order >= 0
        && request.resource.data.order <= 9999
        && request.resource.data.placeId == myPlaceId()
        && request.resource.data.source == 'business'
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByUid.size() > 0
        && request.resource.data.createdByUid.size() <= 128
        && request.resource.data.hiddenByAdmin is bool;
    }

    match /deals/{id} {
      allow read: if isAdmin() || isClient()
        || (isBusiness() && resource.data.placeId == myPlaceId());

      // Solo el negocio crea ofertas, a su nombre y con el nombre real del lugar
      allow create: if isBusiness()
        && dealTextOk()
        && request.resource.data.hiddenByAdmin == false
        && request.resource.data.createdByUid == request.auth.uid
        && exists(/databases/$(database)/documents/places/$(myPlaceId()))
        && request.resource.data.businessName == placeOf(myPlaceId()).name;

      // Puede corregir, pausar o cambiar fechas. No quita la ocultación de CJ ni cambia de lugar.
      allow update: if isBusiness()
        && resource.data.placeId == myPlaceId()
        && resource.data.source == 'business'
        && dealTextOk()
        && request.resource.data.hiddenByAdmin == resource.data.hiddenByAdmin
        && request.resource.data.createdByUid == resource.data.createdByUid
        && (request.resource.data.businessName == resource.data.businessName
            || (exists(/databases/$(database)/documents/places/$(myPlaceId()))
                && request.resource.data.businessName == placeOf(myPlaceId()).name));

      // CJ no redacta ofertas nuevas. En las del negocio solo puede ocultarlas.
      // En las antiguas (sin source business) puede seguir corrigiéndolas.
      allow update: if isAdmin() && (
        (resource.data.get('source', 'cj') == 'business'
          && changedKeys().hasOnly(['hiddenByAdmin'])
          && request.resource.data.hiddenByAdmin is bool)
        || (resource.data.get('source', 'cj') != 'business'
          && request.resource.data.get('source', 'cj') != 'business')
      );

      allow delete: if isAdmin()
        || (isBusiness()
            && resource.data.placeId == myPlaceId()
            && resource.data.source == 'business');
    }

    // Ajustes generales, p. ej. settings/tipOfTheWeek
    match /settings/{id} {
      allow read: if isAdmin() || isClient();
      allow write: if isAdmin();
    }

    // ---------- dealUses/{id} ----------
    // El cliente solo crea registros a su nombre, de un descuento que existe y con la hora del servidor.
    // No puede leerlos, cambiarlos ni borrarlos; solo CJ los lee.
    match /dealUses/{id} {
      allow create: if isClient()
        && request.resource.data.keys().hasOnly(['dealId', 'clientId', 'date'])
        && request.resource.data.clientId == me().clientId
        && request.resource.data.dealId is string
        && exists(/databases/$(database)/documents/deals/$(request.resource.data.dealId))
        && request.resource.data.date == request.time;
      allow read, delete: if isAdmin();
    }

    // ---------- conversations/{clientId} y sus mensajes ----------
    // Una conversación por cliente con el equipo de CJ. El cliente solo accede a la suya.
    function isMyClient(clientId) {
      return isClient() && me().clientId == clientId;
    }

    function familyNameOf(clientId) {
      return get(/databases/$(database)/documents/clients/$(clientId)).data.familyName;
    }

    function validText(t, max) {
      return t is string && t.size() > 0 && t.size() <= max;
    }

    // Restaurante con botón de reserva configurado por CJ
    function bookableRestaurant(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 200
        && exists(/databases/$(database)/documents/places/$(id))
        && placeOf(id).category == 'restaurants'
        && placeOf(id).reservationChannel in ['link', 'phone', 'whatsapp']
        && placeOf(id).reservationTarget is string
        && placeOf(id).reservationTarget.size() > 0
        && placeOf(id).reservationTarget.size() <= 2000;
    }

    match /conversations/{clientId} {
      allow read: if isAdmin() || isMyClient(clientId);

      // El cliente actualiza el resumen al escribir, o solo su hora de lectura
      allow create, update: if isMyClient(clientId)
        && request.resource.data.clientId == clientId
        && request.resource.data.familyName == familyNameOf(clientId)
        && (
          (request.resource.data.lastSender == 'client'
            && request.resource.data.lastMessageAt == request.time
            && validText(request.resource.data.lastMessageText, 200)
            && request.resource.data.keys().hasOnly(['clientId', 'familyName', 'lastMessageAt', 'lastMessageText', 'lastSender', 'clientReadAt', 'cjReadAt'])
            && (resource == null || request.resource.data.get('cjReadAt', null) == resource.data.get('cjReadAt', null)))
          || (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientReadAt'])
            && request.resource.data.clientReadAt == request.time)
        );

      // El equipo de CJ escribe como "cj" o marca como leída
      allow create, update: if isAdmin()
        && request.resource.data.clientId == clientId
        && (request.resource.data.lastSender in ['client', 'cj']);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || isMyClient(clientId);
        allow create: if request.resource.data.keys().hasOnly(['text', 'sender', 'authorUid', 'authorName', 'createdAt'])
          && validText(request.resource.data.text, 2000)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.createdAt == request.time
          && ((isMyClient(clientId) && request.resource.data.sender == 'client')
              || (isAdmin() && request.resource.data.sender == 'cj'));
        // Los mensajes no se editan; solo CJ puede borrarlos (p. ej. en una baja)
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---------- requests/{id} ----------
    // Peticiones a CJ. El cliente crea y ve las suyas, y solo puede cancelarlas mientras son nuevas.
    match /requests/{id} {
      allow read: if isAdmin() || (isClient() && resource.data.clientId == me().clientId);

      allow create: if isClient()
        && request.resource.data.keys().hasOnly(['clientId', 'familyName', 'type', 'description', 'preferredDate', 'status', 'createdByUid', 'createdAt', 'updatedAt'])
        && request.resource.data.clientId == me().clientId
        && request.resource.data.familyName == familyNameOf(me().clientId)
        && request.resource.data.type in ['repair', 'budget', 'keys', 'cleaning', 'other']
        && validText(request.resource.data.description, 2000)
        && (!('preferredDate' in request.resource.data) || request.resource.data.preferredDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.status == 'new'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isClient()
        && resource.data.clientId == me().clientId
        && resource.data.status == 'new'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.status in ['new', 'in_progress', 'done', 'cancelled']
        && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isAdmin();
    }

    // ---------- reservationClicks / reservationConfirms / reservationReports ----------
    // Pinchazo en Reservar. El cliente solo crea el suyo, con la hora del servidor.
    // No puede leer los de nadie (tampoco los suyos). Solo CJ lee. Nadie los borra desde la app.
    match /reservationClicks/{id} {
      allow create: if isClient()
        && request.resource.data.keys().hasOnly(['placeId', 'clientId', 'uid', 'channel', 'createdAt'])
        && request.resource.data.clientId == me().clientId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.channel in ['link', 'phone', 'whatsapp']
        && bookableRestaurant(request.resource.data.placeId)
        && placeOf(request.resource.data.placeId).reservationChannel == request.resource.data.channel
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // El cliente, al volver, puede decir que consiguió mesa. Mismas reglas: solo crea, solo CJ lee.
    match /reservationConfirms/{id} {
      allow create: if isClient()
        && request.resource.data.keys().hasOnly(['placeId', 'clientId', 'uid', 'createdAt'])
        && request.resource.data.clientId == me().clientId
        && request.resource.data.uid == request.auth.uid
        && bookableRestaurant(request.resource.data.placeId)
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Número de reservas que el restaurante comunica a CJ, por mes. Solo el equipo lo ve y lo anota.
    match /reservationReports/{id} {
      function validReport() {
        return request.resource.data.keys().hasOnly(['placeId', 'month', 'count', 'updatedAt'])
          && request.resource.data.placeId is string
          && request.resource.data.month is string
          && request.resource.data.month.matches('[0-9]{4}-(0[1-9]|1[0-2])')
          && id == request.resource.data.placeId + '_' + request.resource.data.month
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= 100000
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
          && placeOf(request.resource.data.placeId).category == 'restaurants';
      }
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validReport();
      allow delete: if false;
    }

    // ---------- Contactos y notas de la casa del cliente ----------
    // Privados por defecto. Viven en una colección que el equipo de CJ no puede leer.
    // Si el cliente marca "Compartir con CJ", el documento pasa a la colección compartida.
    // Un negocio colaborador no es admin ni el cliente: no puede leer ninguna de las dos.
    // Cualquier persona con la misma ficha (clientId) sí: es la misma cuenta familiar.

    function optionalText(t, max) {
      return t is string && t.size() <= max;
    }

    function optionalEmail(t) {
      return t is string && t.size() <= 120 && (t.size() == 0 || (t.size() >= 6 && t.matches('.+@.+[.].+')));
    }

    function serviceIdOk(value) {
      return value is string && value.size() > 0 && value.size() <= 80 && value.matches('[A-Za-z0-9_-]+');
    }

    // Los seis de siempre valen aunque aún no haya documento. El resto tiene que existir
    // en partnerCategories (también si CJ lo ha ocultado). "other" es el texto libre.
    function ownServiceKnown(value) {
      return serviceIdOk(value) && (
        value == 'lawyer' || value == 'gestoria' || value == 'pool'
        || value == 'maintenance' || value == 'garden' || value == 'communityAdmin'
        || value == 'other'
        || exists(/databases/$(database)/documents/partnerCategories/$(value))
      );
    }

    // Si CJ borra el servicio después, el contacto se puede seguir corrigiendo con el mismo id.
    function ownServiceAllowed(data, previous) {
      return ownServiceKnown(data.get('service', ''))
        || (serviceIdOk(data.get('service', '')) && data.get('service', '') == previous.get('service', ''));
    }

    // "service" es una palabra reservada de las reglas: se lee el campo con get().
    function otherLabelOk(kind, label) {
      return (kind == 'other' && validText(label, 80)) || (kind != 'other' && label is string && label.size() == 0);
    }

    function houseSectionOk(section) {
      return section == 'wifi' || section == 'alarm' || section == 'meters'
        || section == 'keys' || section == 'rubbish' || section == 'other';
    }

    function ownContactData(data, shared) {
      return data.keys().hasOnly(['name', 'service', 'serviceOther', 'phone', 'email', 'notes', 'shareWithCj', 'createdAt', 'updatedAt'])
        && validText(data.name, 120)
        && serviceIdOk(data.get('service', ''))
        && otherLabelOk(data.get('service', ''), data.get('serviceOther', ''))
        && optionalText(data.phone, 40)
        && optionalEmail(data.email)
        && optionalText(data.notes, 2000)
        && data.shareWithCj == shared
        && data.updatedAt == request.time;
    }

    function houseNoteData(data, shared) {
      return data.keys().hasOnly(['section', 'title', 'body', 'secret', 'shareWithCj', 'createdAt', 'updatedAt'])
        && houseSectionOk(data.section)
        && validText(data.title, 120)
        && optionalText(data.body, 4000)
        && optionalText(data.secret, 200)
        && (data.body.size() > 0 || data.secret.size() > 0)
        && data.shareWithCj == shared
        && data.updatedAt == request.time;
    }

    match /clients/{clientId}/ownContacts/{id} {
      allow read: if isMyClient(clientId);
      allow create: if isMyClient(clientId)
        && ownContactData(request.resource.data, false)
        && ownServiceKnown(request.resource.data.get('service', ''))
        && request.resource.data.createdAt == request.time;
      allow update: if isMyClient(clientId)
        && ownContactData(request.resource.data, false)
        && ownServiceAllowed(request.resource.data, resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMyClient(clientId);
    }

    match /clients/{clientId}/sharedContacts/{id} {
      allow read: if isMyClient(clientId) || isAdmin();
      allow create: if isMyClient(clientId)
        && ownContactData(request.resource.data, true)
        && ownServiceKnown(request.resource.data.get('service', ''))
        && request.resource.data.createdAt == request.time;
      allow update: if isMyClient(clientId)
        && ownContactData(request.resource.data, true)
        && ownServiceAllowed(request.resource.data, resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMyClient(clientId);
    }

    match /clients/{clientId}/houseNotes/{id} {
      allow read: if isMyClient(clientId);
      allow create: if isMyClient(clientId)
        && houseNoteData(request.resource.data, false)
        && request.resource.data.createdAt == request.time;
      allow update: if isMyClient(clientId)
        && houseNoteData(request.resource.data, false)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMyClient(clientId);
    }

    match /clients/{clientId}/sharedHouseNotes/{id} {
      allow read: if isMyClient(clientId) || isAdmin();
      allow create: if isMyClient(clientId)
        && houseNoteData(request.resource.data, true)
        && request.resource.data.createdAt == request.time;
      allow update: if isMyClient(clientId)
        && houseNoteData(request.resource.data, true)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMyClient(clientId);
    }

    // ---------- mailLog/{id} ----------
    // Registro de correos de invitación enviados por el servidor. Solo CJ lo lee; nadie escribe desde la app.
    match /mailLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Todo lo demás: denegado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
