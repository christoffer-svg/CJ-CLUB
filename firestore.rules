rules_version = '2';


// Reglas de seguridad de Firestore de CJ Club.
// Principio: todo está denegado salvo lo que se permite expresamente aquí.
// Las funciones de servidor (carpeta functions/) usan permisos de administrador y no pasan por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quién hace la petición ----------

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Ficha users/{uid} de quien hace la petición
    function me() {
      return get(userPath(request.auth.uid)).data;
    }

    // Persona invitada por CJ: tiene sesión y ficha en users/
    function isMember() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function isAdmin() {
      return isMember() && me().role == 'admin';
    }

    function isClient() {
      return isMember() && me().role == 'client' && me().clientId is string;
    }

    // Negocio colaborador invitado por CJ, vinculado a un lugar
    function isBuilder() {
      return isMember() && me().role == 'builder';
    }

    // Arquitecto o diseñador invitado por CJ a una o varias reformas
    function isDesigner() {
      return isMember() && me().role == 'designer';
    }

    function isBusiness() {
      return isMember()
        && me().role == 'business'
        && me().placeId is string
        && me().placeId.size() > 0
        && me().placeId.size() <= 200;
    }

    function myPlaceId() {
      return me().placeId;
    }

    function placeOf(id) {
      return get(/databases/$(database)/documents/places/$(id)).data;
    }

    // Si el rol es negocio, tiene que quedar vinculado a un lugar que existe
    function businessLinked() {
      return request.resource.data.role != 'business'
        || (request.resource.data.placeId is string
            && request.resource.data.placeId.size() > 0
            && request.resource.data.placeId.size() <= 200
            && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId)));
    }

    // Colaborador asignado en el mapa contacts de la ficha del cliente
    function isMyPartner(partnerId) {
      return isClient()
        && partnerId in get(/databases/$(database)/documents/clients/$(me().clientId)).data.contacts.values();
    }

    // Accesos de una ficha (cliente, negocio, constructor, equipo de CJ); las antiguas solo tienen "role".
    // "role" es el acceso que está usando ahora; "roles", todos los que le ha dado CJ.
    function rolesIn(data) {
      return data.get('roles', [data.role]);
    }

    function validRoles() {
      return request.resource.data.role in ['admin', 'client', 'business', 'builder', 'designer']
        && rolesIn(request.resource.data) is list
        && rolesIn(request.resource.data).size() >= 1
        && rolesIn(request.resource.data).size() <= 4
        && rolesIn(request.resource.data).hasOnly(['admin', 'client', 'business', 'builder', 'designer'])
        && request.resource.data.role in rolesIn(request.resource.data);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- users/{uid} ----------
    match /users/{uid} {
      // Cada persona lee solo su ficha; el equipo de CJ, todas
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      // Cualquier persona con varios accesos puede pasar de uno a otro, solo entre los que le ha dado CJ
      allow update: if isMember() && request.auth.uid == uid
        && changedKeys().hasOnly(['role'])
        && request.resource.data.role in rolesIn(resource.data)
        && (request.resource.data.role != 'client' || resource.data.get('clientId', null) is string)
        && businessLinked();

      // Un cliente solo puede cambiar su idioma, sus favoritos y cuál de SUS casas está viendo
      // (clientId debe estar en clientIds, que solo asigna CJ)
      allow update: if isClient() && request.auth.uid == uid
        && changedKeys().hasOnly(['language', 'favorites', 'clientId'])
        && (!changedKeys().hasAny(['clientId']) || request.resource.data.clientId in resource.data.get('clientIds', []))
        && request.resource.data.language in ['es', 'en', 'nl', 'sv', 'de', 'fr']
        && (!('favorites' in request.resource.data)
            || (request.resource.data.favorites is list && request.resource.data.favorites.size() <= 200));

      // Un arquitecto o diseñador solo puede cambiar su idioma
      allow update: if isDesigner() && request.auth.uid == uid
        && changedKeys().hasOnly(['language'])
        && request.resource.data.language in ['es', 'en', 'nl', 'sv', 'de', 'fr'];

      // Un constructor solo puede cambiar su idioma
      allow update: if isBuilder() && request.auth.uid == uid
        && changedKeys().hasOnly(['language'])
        && request.resource.data.language in ['es', 'en', 'nl', 'sv', 'de', 'fr'];

      // Un negocio solo puede cambiar su idioma
      allow update: if isBusiness() && request.auth.uid == uid
        && changedKeys().hasOnly(['language'])
        && request.resource.data.language in ['es', 'en', 'nl', 'sv', 'de', 'fr'];

      // El equipo de CJ gestiona las fichas, pero nadie puede darse accesos a sí mismo ni borrarse
      allow update: if isAdmin()
        && validRoles()
        && businessLinked()
        && (uid != request.auth.uid || !changedKeys().hasAny(['role', 'roles']));
      allow create: if isAdmin() && uid != request.auth.uid
        && validRoles()
        && businessLinked();
      allow delete: if isAdmin() && uid != request.auth.uid;
    }

    // ---------- clients/{clientId} ----------
    match /clients/{clientId} {
      // Un cliente lee la casa que está viendo y las demás de sus casas (para el selector)
      allow read: if isAdmin() || (isClient() && (me().clientId == clientId || clientId in me().get('clientIds', [])));
      allow write: if isAdmin();
    }

    // ---------- partners/{id} ----------
    // Un cliente solo lee, de uno en uno, los colaboradores asignados a él; nunca la lista completa
    match /partners/{id} {
      allow get: if isAdmin() || isMyPartner(id);
      allow list: if isAdmin();
      allow write: if isAdmin() && (request.resource == null || profileOk('partners', id));
    }

    // ---------- partnerCategories/{id} ----------
    // Servicios de los colaboradores (abogado, piscina, y los que CJ añada).
    // Los clientes los leen para ver el nombre. El negocio no los necesita.
    // Solo el equipo de CJ los cambia. Borrar uno que está en uso lo impide el panel.
    match /partnerCategories/{id} {
      allow read: if isAdmin() || isClient();
      allow write: if isAdmin();
    }

    // ---------- Contenido común: los socios lo leen; el negocio no ----------
    match /generalContacts/{id} {
      allow read: if isAdmin() || isClient();
      allow write: if isAdmin();
    }

    // Presentación pública de un colaborador (ver PublicProfile en src/lib/types.ts). Todo opcional.
    function profileText(f, max) {
      return !(f in request.resource.data) || (request.resource.data[f] is string && request.resource.data[f].size() <= max);
    }

    // Foto subida por el servidor (función uploadProfilePhoto) a la carpeta de ese colaborador
    function profilePhotoOk(a, coll, id) {
      return a is map
        && a.path is string && a.path.matches('profiles/' + coll + '/' + id + '/photos/.+')
        && a.url is string
        && (a.url.matches('https://firebasestorage[.]googleapis[.]com/.+') || a.url.matches('http://127[.]0[.]0[.]1:9199/.+'));
    }

    function profilePhotosOk(coll, id) {
      let list = request.resource.data.get('photos', []);
      return list is list && list.size() <= 10
        && (list.size() < 1 || profilePhotoOk(list[0], coll, id))
        && (list.size() < 2 || profilePhotoOk(list[1], coll, id))
        && (list.size() < 3 || profilePhotoOk(list[2], coll, id))
        && (list.size() < 4 || profilePhotoOk(list[3], coll, id))
        && (list.size() < 5 || profilePhotoOk(list[4], coll, id))
        && (list.size() < 6 || profilePhotoOk(list[5], coll, id))
        && (list.size() < 7 || profilePhotoOk(list[6], coll, id))
        && (list.size() < 8 || profilePhotoOk(list[7], coll, id))
        && (list.size() < 9 || profilePhotoOk(list[8], coll, id))
        && (list.size() < 10 || profilePhotoOk(list[9], coll, id));
    }

    // Carta: fotos o PDF subidos por el servidor a la carpeta "menu" de ese colaborador
    function menuFileOk(a, coll, id) {
      return a is map
        && a.path is string && a.path.matches('profiles/' + coll + '/' + id + '/menu/.+')
        && a.url is string
        && (a.url.matches('https://firebasestorage[.]googleapis[.]com/.+') || a.url.matches('http://127[.]0[.]0[.]1:9199/.+'));
    }

    function menuOk(coll, id) {
      let list = request.resource.data.get('menu', []);
      return list is list && list.size() <= 10
        && (list.size() < 1 || menuFileOk(list[0], coll, id))
        && (list.size() < 2 || menuFileOk(list[1], coll, id))
        && (list.size() < 3 || menuFileOk(list[2], coll, id))
        && (list.size() < 4 || menuFileOk(list[3], coll, id))
        && (list.size() < 5 || menuFileOk(list[4], coll, id))
        && (list.size() < 6 || menuFileOk(list[5], coll, id))
        && (list.size() < 7 || menuFileOk(list[6], coll, id))
        && (list.size() < 8 || menuFileOk(list[7], coll, id))
        && (list.size() < 9 || menuFileOk(list[8], coll, id))
        && (list.size() < 10 || menuFileOk(list[9], coll, id));
    }

    function profileOk(coll, id) {
      return profileText('about_es', 4000) && profileText('about_en', 4000)
        && profileText('orderInfo_es', 600) && profileText('orderInfo_en', 600)
        && request.resource.data.get('takeaway', false) is bool
        && request.resource.data.get('delivery', false) is bool
        && menuOk(coll, id)
        && profileText('hours_es', 600) && profileText('hours_en', 600)
        && profileText('phone', 40) && profileText('email', 120)
        && profileText('instagram', 100) && profileText('address', 300)
        && profileText('website', 300)
        && (request.resource.data.get('website', '') == '' || request.resource.data.website.matches('https://[^ ]+'))
        && profilePhotosOk(coll, id);
    }

    match /places/{id} {
      allow get: if isAdmin() || isClient() || (isBusiness() && id == myPlaceId());
      allow list: if isAdmin() || isClient();
      allow write: if isAdmin() && (request.resource == null || profileOk('places', id));
      // El negocio escribe su presentación (y nada más de la ficha, que es de CJ)
      allow update: if isBusiness() && id == myPlaceId()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['about_es', 'about_en', 'hours_es', 'hours_en', 'phone', 'email', 'website', 'instagram', 'address', 'photos',
                       'menu', 'takeaway', 'delivery', 'orderInfo_es', 'orderInfo_en'])
        && profileOk('places', id);
    }

    // ---------- events/{id} y eventBookings/{id} ----------
    // Eventos de un negocio (cata, música en vivo…). Los publica el negocio de ese lugar o CJ.
    function eventOk(placeId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['placeId', 'businessName', 'kind', 'title', 'about_es', 'about_en', 'date', 'time', 'endTime',
          'price', 'capacity', 'bookable', 'active', 'hiddenByAdmin', 'photo', 'createdByUid', 'createdAt', 'updatedAt'])
        && d.placeId == placeId
        && exists(/databases/$(database)/documents/places/$(placeId))
        && d.businessName == placeOf(placeId).name
        && d.kind in ['tasting', 'music', 'dinner', 'other']
        && validText(d.title, 120)
        && d.about_es is string && d.about_es.size() <= 2000
        && d.about_en is string && d.about_en.size() <= 2000
        && d.date is string && d.date.matches('20[0-9]{2}-[01][0-9]-[0-3][0-9]')
        && d.time is string && d.time.matches('[0-2][0-9]:[0-5][0-9]')
        && d.endTime is string && (d.endTime == '' || d.endTime.matches('[0-2][0-9]:[0-5][0-9]'))
        && number(d.price, 0, 100000)
        && d.capacity is int && d.capacity >= 0 && d.capacity <= 5000
        && d.bookable is bool && d.active is bool && d.hiddenByAdmin is bool
        && (d.get('photo', null) == null || profilePhotoOk(d.photo, 'places', placeId))
        && d.createdByUid is string;
    }

    match /events/{id} {
      allow read: if isAdmin() || isClient()
        || (isBusiness() && resource.data.placeId == myPlaceId());
      allow create: if (isAdmin() && eventOk(request.resource.data.placeId))
        || (isBusiness() && eventOk(myPlaceId())
            && request.resource.data.hiddenByAdmin == false
            && request.resource.data.createdByUid == request.auth.uid);
      // El negocio no quita la ocultación de CJ ni lo cambia de lugar
      allow update: if (isAdmin() && eventOk(resource.data.placeId))
        || (isBusiness() && resource.data.placeId == myPlaceId() && eventOk(myPlaceId())
            && request.resource.data.hiddenByAdmin == resource.data.hiddenByAdmin
            && request.resource.data.createdByUid == resource.data.createdByUid);
      allow delete: if isAdmin() || (isBusiness() && resource.data.placeId == myPlaceId());
    }

    function eventOf(id) {
      return get(/databases/$(database)/documents/events/$(id)).data;
    }

    // Solicitud de reserva: la pide el cliente (pendiente), la confirma o rechaza el negocio, la cancela el cliente.
    match /eventBookings/{id} {
      allow read: if isAdmin()
        || (isClient() && resource.data.clientId == me().clientId)
        || (isBusiness() && resource.data.placeId == myPlaceId());
      allow create: if isClient()
        && request.resource.data.keys().hasOnly(['eventId', 'placeId', 'eventTitle', 'eventDate', 'eventTime', 'clientId', 'uid',
             'name', 'people', 'phone', 'note', 'status', 'reply', 'createdAt', 'answeredAt', 'cancelledAt'])
        && request.resource.data.clientId == me().clientId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reply == ''
        && request.resource.data.answeredAt == null && request.resource.data.cancelledAt == null
        && request.resource.data.createdAt == request.time
        && validText(request.resource.data.name, 120)
        && request.resource.data.people is int && request.resource.data.people >= 1 && request.resource.data.people <= 20
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 40
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.eventId is string
        && exists(/databases/$(database)/documents/events/$(request.resource.data.eventId))
        && eventOf(request.resource.data.eventId).bookable == true
        && eventOf(request.resource.data.eventId).active == true
        && eventOf(request.resource.data.eventId).hiddenByAdmin == false
        && request.resource.data.placeId == eventOf(request.resource.data.eventId).placeId
        && request.resource.data.eventTitle == eventOf(request.resource.data.eventId).title
        && request.resource.data.eventDate == eventOf(request.resource.data.eventId).date
        && request.resource.data.eventTime == eventOf(request.resource.data.eventId).time;
      allow update: if
        // el cliente cancela la suya
        (isClient() && resource.data.clientId == me().clientId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
          && resource.data.status in ['pending', 'confirmed']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time)
        // el negocio (o CJ) responde; puede cambiar de opinión mientras el cliente no la cancele
        || ((isAdmin() || (isBusiness() && resource.data.placeId == myPlaceId()))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply', 'answeredAt'])
          && resource.data.status in ['pending', 'confirmed', 'declined']
          && request.resource.data.status in ['confirmed', 'declined']
          && request.resource.data.reply is string && request.resource.data.reply.size() <= 500
          && request.resource.data.answeredAt == request.time);
      allow delete: if false;
    }

    // Texto de un descuento publicado por el negocio. Sin campos de más.
    function dealTextOk() {
      return request.resource.data.keys().hasOnly([
          'title', 'conditions_es', 'conditions_en', 'discountLabel', 'code', 'active', 'order',
          'placeId', 'businessName', 'description_es', 'description_en', 'validFrom', 'validUntil',
          'source', 'createdByUid', 'hiddenByAdmin'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.discountLabel is string
        && request.resource.data.discountLabel.size() > 0
        && request.resource.data.discountLabel.size() <= 40
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 40
        && request.resource.data.conditions_es is string
        && request.resource.data.conditions_es.size() <= 2000
        && request.resource.data.conditions_en is string
        && request.resource.data.conditions_en.size() <= 2000
        && request.resource.data.description_es is string
        && request.resource.data.description_es.size() <= 2000
        && request.resource.data.description_en is string
        && request.resource.data.description_en.size() <= 2000
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.businessName.size() <= 200
        && request.resource.data.validFrom is string
        && (request.resource.data.validFrom.size() == 0 || request.resource.data.validFrom.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.validUntil is string
        && (request.resource.data.validUntil.size() == 0 || request.resource.data.validUntil.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && (request.resource.data.validFrom.size() == 0
            || request.resource.data.validUntil.size() == 0
            || request.resource.data.validFrom <= request.resource.data.validUntil)
        && request.resource.data.active is bool
        && request.resource.data.order is number
        && request.resource.data.order >= 0
        && request.resource.data.order <= 9999
        && request.resource.data.placeId == myPlaceId()
        && request.resource.data.source == 'business'
        && request.resource.data.createdByUid is string
        && request.resource.data.createdByUid.size() > 0
        && request.resource.data.createdByUid.size() <= 128
        && request.resource.data.hiddenByAdmin is bool;
    }

    match /deals/{id} {
      allow read: if isAdmin() || isClient()
        || (isBusiness() && resource.data.placeId == myPlaceId());

      // Solo el negocio crea ofertas, a su nombre y con el nombre real del lugar
      allow create: if isBusiness()
        && dealTextOk()
        && request.resource.data.hiddenByAdmin == false
        && request.resource.data.createdByUid == request.auth.uid
        && exists(/databases/$(database)/documents/places/$(myPlaceId()))
        && request.resource.data.businessName == placeOf(myPlaceId()).name;

      // Puede corregir, pausar o cambiar fechas. No quita la ocultación de CJ ni cambia de lugar.
      allow update: if isBusiness()
        && resource.data.placeId == myPlaceId()
        && resource.data.source == 'business'
        && dealTextOk()
        && request.resource.data.hiddenByAdmin == resource.data.hiddenByAdmin
        && request.resource.data.createdByUid == resource.data.createdByUid
        && (request.resource.data.businessName == resource.data.businessName
            || (exists(/databases/$(database)/documents/places/$(myPlaceId()))
                && request.resource.data.businessName == placeOf(myPlaceId()).name));

      // CJ no redacta ofertas nuevas. En las del negocio solo puede ocultarlas.
      // En las antiguas (sin source business) puede seguir corrigiéndolas.
      allow update: if isAdmin() && (
        (resource.data.get('source', 'cj') == 'business'
          && changedKeys().hasOnly(['hiddenByAdmin'])
          && request.resource.data.hiddenByAdmin is bool)
        || (resource.data.get('source', 'cj') != 'business'
          && request.resource.data.get('source', 'cj') != 'business')
      );

      allow delete: if isAdmin()
        || (isBusiness()
            && resource.data.placeId == myPlaceId()
            && resource.data.source == 'business');
    }

    // Ajustes generales, p. ej. settings/tipOfTheWeek
    match /settings/{id} {
      allow read: if isAdmin() || isClient();
      allow write: if isAdmin();
    }

    // ---------- dealUses/{id} ----------
    // El cliente solo crea registros a su nombre, de un descuento que existe y con la hora del servidor.
    // No puede leerlos, cambiarlos ni borrarlos; solo CJ los lee.
    match /dealUses/{id} {
      allow create: if isClient()
        && request.resource.data.keys().hasOnly(['dealId', 'clientId', 'date'])
        && request.resource.data.clientId == me().clientId
        && request.resource.data.dealId is string
        && exists(/databases/$(database)/documents/deals/$(request.resource.data.dealId))
        && request.resource.data.date == request.time;
      allow read, delete: if isAdmin();
    }

    // ---------- conversations/{clientId} y sus mensajes ----------
    // Una conversación por cliente con el equipo de CJ. El cliente solo accede a la suya.
    function isMyClient(clientId) {
      return isClient() && me().clientId == clientId;
    }

    function familyNameOf(clientId) {
      return get(/databases/$(database)/documents/clients/$(clientId)).data.familyName;
    }

    function validText(t, max) {
      return t is string && t.size() > 0 && t.size() <= max;
    }

    // Restaurante con botón de reserva configurado por CJ
    function bookableRestaurant(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 200
        && exists(/databases/$(database)/documents/places/$(id))
        && placeOf(id).category == 'restaurants'
        && placeOf(id).reservationChannel in ['link', 'phone', 'whatsapp']
        && placeOf(id).reservationTarget is string
        && placeOf(id).reservationTarget.size() > 0
        && placeOf(id).reservationTarget.size() <= 2000;
    }

    match /conversations/{clientId} {
      allow read: if isAdmin() || isMyClient(clientId);

      // El cliente actualiza el resumen al escribir, o solo su hora de lectura
      allow create, update: if isMyClient(clientId)
        && request.resource.data.clientId == clientId
        && request.resource.data.familyName == familyNameOf(clientId)
        && (
          (request.resource.data.lastSender == 'client'
            && request.resource.data.lastMessageAt == request.time
            && validText(request.resource.data.lastMessageText, 200)
            && request.resource.data.keys().hasOnly(['clientId', 'familyName', 'lastMessageAt', 'lastMessageText', 'lastSender', 'clientReadAt', 'cjReadAt'])
            && (resource == null || request.resource.data.get('cjReadAt', null) == resource.data.get('cjReadAt', null)))
          || (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientReadAt'])
            && request.resource.data.clientReadAt == request.time)
        );

      // El equipo de CJ escribe como "cj" o marca como leída
      allow create, update: if isAdmin()
        && request.resource.data.clientId == clientId
        && (request.resource.data.lastSender in ['client', 'cj']);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || isMyClient(clientId);
        allow create: if request.resource.data.keys().hasOnly(['text', 'sender', 'authorUid', 'authorName', 'createdAt'])
          && validText(request.resource.data.text, 2000)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.createdAt == request.time
          && ((isMyClient(clientId) && request.resource.data.sender == 'client')
              || (isAdmin() && request.resource.data.sender == 'cj'));
        // Los mensajes no se editan; solo CJ puede borrarlos (p. ej. en una baja)
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---------- requests/{id} ----------
    // Peticiones a CJ. El cliente crea y ve las suyas, y solo puede cancelarlas mientras son nuevas.
    match /requests/{id} {
      allow read: if isAdmin() || (isClient() && resource.data.clientId == me().clientId);

      allow create: if isClient()
        && request.resource.data.keys().hasOnly(['clientId', 'familyName', 'type', 'description', 'preferredDate', 'status', 'createdByUid', 'createdAt', 'updatedAt'])
        && request.resource.data.clientId == me().clientId
        && request.resource.data.familyName == familyNameOf(me().clientId)
        && request.resource.data.type in ['repair', 'budget', 'keys', 'cleaning', 'other']
        && validText(request.resource.data.description, 2000)
        && (!('preferredDate' in request.resource.data) || request.resource.data.preferredDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.status == 'new'
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isClient()
        && resource.data.clientId == me().clientId
        && resource.data.status == 'new'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && request.resource.data.status in ['new', 'in_progress', 'done', 'cancelled']
        && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isAdmin();
    }

    // ---------- reservationClicks / reservationConfirms / reservationReports ----------
    // Pinchazo en Reservar. El cliente solo crea el suyo, con la hora del servidor.
    // No puede leer los de nadie (tampoco los suyos). Solo CJ lee. Nadie los borra desde la app.
    match /reservationClicks/{id} {
      allow create: if isClient()
        && request.resource.data.keys().hasOnly(['placeId', 'clientId', 'uid', 'channel', 'createdAt'])
        && request.resource.data.clientId == me().clientId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.channel in ['link', 'phone', 'whatsapp']
        && bookableRestaurant(request.resource.data.placeId)
        && placeOf(request.resource.data.placeId).reservationChannel == request.resource.data.channel
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // El cliente, al volver, puede decir que consiguió mesa. Mismas reglas: solo crea, solo CJ lee.
    match /reservationConfirms/{id} {
      allow create: if isClient()
        && request.resource.data.keys().hasOnly(['placeId', 'clientId', 'uid', 'createdAt'])
        && request.resource.data.clientId == me().clientId
        && request.resource.data.uid == request.auth.uid
        && bookableRestaurant(request.resource.data.placeId)
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Número de reservas que el restaurante comunica a CJ, por mes. Solo el equipo lo ve y lo anota.
    match /reservationReports/{id} {
      function validReport() {
        return request.resource.data.keys().hasOnly(['placeId', 'month', 'count', 'updatedAt'])
          && request.resource.data.placeId is string
          && request.resource.data.month is string
          && request.resource.data.month.matches('[0-9]{4}-(0[1-9]|1[0-2])')
          && id == request.resource.data.placeId + '_' + request.resource.data.month
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= 100000
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/places/$(request.resource.data.placeId))
          && placeOf(request.resource.data.placeId).category == 'restaurants';
      }
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validReport();
      allow delete: if false;
    }

    // ---------- Contactos y notas de la casa del cliente ----------
    // Privados por defecto. Viven en una colección que el equipo de CJ no puede leer.
    // Si el cliente marca "Compartir con CJ", el documento pasa a la colección compartida.
    // Un negocio colaborador no es admin ni el cliente: no puede leer ninguna de las dos.
    // Cualquier persona con la misma ficha (clientId) sí: es la misma cuenta familiar.

    function optionalText(t, max) {
      return t is string && t.size() <= max;
    }

    function optionalEmail(t) {
      return t is string && t.size() <= 120 && (t.size() == 0 || (t.size() >= 6 && t.matches('.+@.+[.].+')));
    }

    function serviceIdOk(value) {
      return value is string && value.size() > 0 && value.size() <= 80 && value.matches('[A-Za-z0-9_-]+');
    }

    // Los seis de siempre valen aunque aún no haya documento. El resto tiene que existir
    // en partnerCategories (también si CJ lo ha ocultado). "other" es el texto libre.
    function ownServiceKnown(value) {
      return serviceIdOk(value) && (
        value == 'lawyer' || value == 'gestoria' || value == 'pool'
        || value == 'maintenance' || value == 'garden' || value == 'communityAdmin'
        || value == 'other'
        || exists(/databases/$(database)/documents/partnerCategories/$(value))
      );
    }

    // Si CJ borra el servicio después, el contacto se puede seguir corrigiendo con el mismo id.
    function ownServiceAllowed(data, previous) {
      return ownServiceKnown(data.get('service', ''))
        || (serviceIdOk(data.get('service', '')) && data.get('service', '') == previous.get('service', ''));
    }

    // "service" es una palabra reservada de las reglas: se lee el campo con get().
    function otherLabelOk(kind, label) {
      return (kind == 'other' && validText(label, 80)) || (kind != 'other' && label is string && label.size() == 0);
    }

    function houseSectionOk(section) {
      return section == 'wifi' || section == 'alarm' || section == 'meters'
        || section == 'keys' || section == 'rubbish' || section == 'other';
    }

    function ownContactData(data, shared) {
      return data.keys().hasOnly(['name', 'service', 'serviceOther', 'phone', 'email', 'notes', 'shareWithCj', 'createdAt', 'updatedAt'])
        && validText(data.name, 120)
        && serviceIdOk(data.get('service', ''))
        && otherLabelOk(data.get('service', ''), data.get('serviceOther', ''))
        && optionalText(data.phone, 40)
        && optionalEmail(data.email)
        && optionalText(data.notes, 2000)
        && data.shareWithCj == shared
        && data.updatedAt == request.time;
    }

    function houseNoteData(data, shared) {
      return data.keys().hasOnly(['section', 'title', 'body', 'secret', 'shareWithCj', 'createdAt', 'updatedAt'])
        && houseSectionOk(data.section)
        && validText(data.title, 120)
        && optionalText(data.body, 4000)
        && optionalText(data.secret, 200)
        && (data.body.size() > 0 || data.secret.size() > 0)
        && data.shareWithCj == shared
        && data.updatedAt == request.time;
    }

    match /clients/{clientId}/ownContacts/{id} {
      allow read: if isMyClient(clientId);
      allow create: if isMyClient(clientId)
        && ownContactData(request.resource.data, false)
        && ownServiceKnown(request.resource.data.get('service', ''))
        && request.resource.data.createdAt == request.time;
      allow update: if isMyClient(clientId)
        && ownContactData(request.resource.data, false)
        && ownServiceAllowed(request.resource.data, resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMyClient(clientId);
    }

    match /clients/{clientId}/sharedContacts/{id} {
      allow read: if isMyClient(clientId) || isAdmin();
      allow create: if isMyClient(clientId)
        && ownContactData(request.resource.data, true)
        && ownServiceKnown(request.resource.data.get('service', ''))
        && request.resource.data.createdAt == request.time;
      allow update: if isMyClient(clientId)
        && ownContactData(request.resource.data, true)
        && ownServiceAllowed(request.resource.data, resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMyClient(clientId);
    }

    match /clients/{clientId}/houseNotes/{id} {
      allow read: if isMyClient(clientId);
      allow create: if isMyClient(clientId)
        && houseNoteData(request.resource.data, false)
        && request.resource.data.createdAt == request.time;
      allow update: if isMyClient(clientId)
        && houseNoteData(request.resource.data, false)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMyClient(clientId);
    }

    match /clients/{clientId}/sharedHouseNotes/{id} {
      allow read: if isMyClient(clientId) || isAdmin();
      allow create: if isMyClient(clientId)
        && houseNoteData(request.resource.data, true)
        && request.resource.data.createdAt == request.time;
      allow update: if isMyClient(clientId)
        && houseNoteData(request.resource.data, true)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isMyClient(clientId);
    }

    // ---------- mailLog/{id} ----------
    // Registro de correos de invitación enviados por el servidor. Solo CJ lo lee; nadie escribe desde la app.
    match /mailLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- projects/{id}: Mi reforma ----------
    // Cada obra une una casa (clientId) con un constructor (builderUid). La ven el cliente de esa casa,
    // ese constructor y CJ. Lo que se escribe queda firmado con el papel de cada uno y la hora del servidor,
    // y no se puede editar ni borrar (solo CJ puede borrar), para que no haya discusiones después.
    function project(pid) {
      return get(/databases/$(database)/documents/projects/$(pid)).data;
    }

    function projectRole(pid) {
      return isAdmin() ? 'cj'
        : (isBuilder() && project(pid).builderUid == request.auth.uid) ? 'builder'
        : (isClient() && project(pid).clientId == me().clientId) ? 'client'
        : (isDesigner() && request.auth.uid in project(pid).get('designerUids', [])) ? 'designer'
        : 'none';
    }

    function inProject(pid) {
      return signedIn() && projectRole(pid) != 'none';
    }

    // Partes del contrato (cliente, profesional y CJ): ven el dinero (presupuesto, pagos, extras…).
    // El arquitecto o diseñador ve la conversación, los avances y los planos, pero no el dinero.
    function inDeal(pid) {
      return signedIn() && projectRole(pid) in ['cj', 'builder', 'client'];
    }

    function signedBy(role) {
      return request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorRole == role
        && request.resource.data.authorName is string
        && request.resource.data.createdAt == request.time;
    }

    // Archivo de un avance o pago: dentro de la carpeta de esa misma entrada y con enlace del almacén de Firebase
    function attOk(a, pid, kind, id) {
      return a is map
        && a.path is string && a.path.matches('projects/' + pid + '/' + kind + '/' + id + '/.+')
        && a.url is string
        && (a.url.matches('https://firebasestorage[.]googleapis[.]com/.+') || a.url.matches('http://127[.]0[.]0[.]1:9199/.+'));
    }

    // Lista de archivos (fotos o PDF) en un campo de una entrada: de 1 a 6. Los sube el servidor (uploadProjectFile).
    function validFiles(field, pid, kind, id) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is list
            && request.resource.data[field].size() >= 1
            && request.resource.data[field].size() <= 6
            && attOk(request.resource.data[field][0], pid, kind, id)
            && (request.resource.data[field].size() < 2 || attOk(request.resource.data[field][1], pid, kind, id))
            && (request.resource.data[field].size() < 3 || attOk(request.resource.data[field][2], pid, kind, id))
            && (request.resource.data[field].size() < 4 || attOk(request.resource.data[field][3], pid, kind, id))
            && (request.resource.data[field].size() < 5 || attOk(request.resource.data[field][4], pid, kind, id))
            && (request.resource.data[field].size() < 6 || attOk(request.resource.data[field][5], pid, kind, id)));
    }

    function validAttachments(pid, kind, id) {
      return validFiles('attachments', pid, kind, id);
    }

    // Un pago del plan: nombre y porcentaje entero (el 10 % final no va aquí: siempre queda retenido)
    function milestoneOk(m) {
      return m is map
        && m.keys().hasOnly(['id', 'title', 'percent'])
        && m.id is string && m.id.matches('[A-Za-z0-9]{1,20}')
        && validText(m.title, 120)
        && m.percent is int && m.percent >= 1 && m.percent <= 90;
    }

    function planOk(list) {
      return list is list && list.size() >= 1 && list.size() <= 8
        && milestoneOk(list[0])
        && (list.size() < 2 || milestoneOk(list[1]))
        && (list.size() < 3 || milestoneOk(list[2]))
        && (list.size() < 4 || milestoneOk(list[3]))
        && (list.size() < 5 || milestoneOk(list[4]))
        && (list.size() < 6 || milestoneOk(list[5]))
        && (list.size() < 7 || milestoneOk(list[6]))
        && (list.size() < 8 || milestoneOk(list[7]));
    }

    function money(n) {
      return (n is int || n is float) && n > 0 && n < 100000000;
    }

    function number(n, min, max) {
      return (n is int || n is float) && n >= min && n <= max;
    }

    // Presupuesto por líneas: abierto mientras nadie lo ha firmado. Con una firma, las líneas quedan
    // congeladas (para cambiarlas hay que retirar esa firma); con las dos, cerrado para siempre.
    function signaturePath(pid, r) {
      return /databases/$(database)/documents/projects/$(pid)/signatures/$(r);
    }

    function budgetOpen(pid) {
      return !exists(signaturePath(pid, 'client')) && !exists(signaturePath(pid, 'builder'));
    }

    match /projects/{pid} {
      allow get: if isAdmin()
        || (isBuilder() && resource.data.builderUid == request.auth.uid)
        || (isClient() && resource.data.clientId == me().clientId)
        || (isDesigner() && request.auth.uid in resource.data.get('designerUids', []));
      // Listas: el profesional filtra por builderUid, el cliente por clientId y el arquitecto por designerUids
      allow list: if isAdmin()
        || (isBuilder() && resource.data.builderUid == request.auth.uid)
        || (isClient() && resource.data.clientId == me().clientId)
        || (isDesigner() && request.auth.uid in resource.data.get('designerUids', []));
      allow create, update: if isAdmin()
        && request.resource.data.clientId is string
        && request.resource.data.builderUid is string
        && request.resource.data.status in ['planned', 'in_progress', 'finished']
        && (request.resource.data.budget is int || request.resource.data.budget is float)
        && request.resource.data.budget >= 0
        && request.resource.data.get('vatRate', 21) in [10, 21]
        && (!('designerUids' in request.resource.data) || (request.resource.data.designerUids is list && request.resource.data.designerUids.size() <= 10))
        && (!('reformId' in request.resource.data) || (request.resource.data.reformId is string && request.resource.data.reformId.matches('[A-Za-z0-9_-]{1,40}')))
        && request.resource.data.get('trade', 'construction') in ['construction', 'electrician', 'plumber', 'carpenter', 'painter', 'glazier', 'other']
        // Con el presupuesto ya firmado (aunque sea por uno), el IVA no cambia
        && (resource == null || budgetOpen(pid) || request.resource.data.get('vatRate', 21) == resource.data.get('vatRate', 21));
      allow delete: if isAdmin();

      match /messages/{id} {
        allow read: if inProject(pid);
        allow create: if inProject(pid)
          && request.resource.data.keys().hasOnly(['text', 'sender', 'authorUid', 'authorName', 'createdAt'])
          && validText(request.resource.data.text, 2000)
          && request.resource.data.sender == projectRole(pid)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Avances: los publica el constructor o CJ
      match /updates/{id} {
        allow read: if inProject(pid);
        allow create: if projectRole(pid) in ['builder', 'cj']
          && request.resource.data.keys().hasOnly(['title', 'text', 'percent', 'attachments', 'authorUid', 'authorRole', 'authorName', 'createdAt'])
          && validAttachments(pid, 'updates', id)
          && validText(request.resource.data.title, 200)
          && (request.resource.data.text == '' || validText(request.resource.data.text, 4000))
          && (!('percent' in request.resource.data)
              || (request.resource.data.percent is int && request.resource.data.percent >= 0 && request.resource.data.percent <= 100))
          && signedBy(projectRole(pid));
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Pagos: cualquiera de los tres los anota como "pending"; la OTRA parte (cliente o constructor) los
      // confirma o los discute una sola vez. CJ también puede confirmar.
      match /payments/{id} {
        allow read: if inDeal(pid);
        allow create: if inDeal(pid)
          && request.resource.data.keys().hasOnly(['amount', 'date', 'concept', 'milestoneId', 'attachments', 'recordedByUid', 'recordedByRole', 'recordedByName', 'status', 'createdAt'])
          && (!('milestoneId' in request.resource.data)
              || (request.resource.data.milestoneId is string
                  && request.resource.data.milestoneId.matches('[A-Za-z0-9]{1,20}')
                  // El 10 % final solo cuando el cliente ha confirmado que los repasos están terminados
                  && (request.resource.data.milestoneId != 'final'
                      || exists(/databases/$(database)/documents/projects/$(pid)/plan/release))))
          && validAttachments(pid, 'payments', id)
          && money(request.resource.data.amount)
          && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && validText(request.resource.data.concept, 200)
          && request.resource.data.recordedByUid == request.auth.uid
          && request.resource.data.recordedByRole == projectRole(pid)
          && request.resource.data.recordedByName is string
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if inDeal(pid)
          && resource.data.status == 'pending'
          && (projectRole(pid) == 'cj' || (projectRole(pid) != resource.data.recordedByRole))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedByUid', 'confirmedByRole', 'confirmedByName', 'confirmedAt'])
          && request.resource.data.status in ['confirmed', 'disputed']
          && request.resource.data.confirmedByUid == request.auth.uid
          && request.resource.data.confirmedByRole == projectRole(pid)
          && request.resource.data.confirmedByName is string
          && request.resource.data.confirmedAt == request.time;
        allow delete: if isAdmin();
      }

      // Presupuesto: partidas ("Baño completo") y lo que incluye cada una (grifo, mampara, plato de ducha…)
      // con su precio sin IVA y fotos. Lo escriben el constructor o CJ mientras nadie haya firmado
      match /budgetLines/{id} {
        allow read: if inDeal(pid);
        allow create, update: if projectRole(pid) in ['builder', 'cj']
          && budgetOpen(pid)
          && request.resource.data.keys().hasOnly(['kind', 'parentId', 'title', 'description', 'quantity', 'unit', 'unitPrice', 'order', 'attachments', 'authorUid', 'authorRole', 'authorName', 'createdAt', 'updatedAt'])
          // Partida ("group": baño completo) con su precio cerrado, o elemento; dentro de una partida, el
          // elemento es orientativo (precio de referencia)
          && request.resource.data.get('kind', 'item') in ['group', 'item']
          && (request.resource.data.get('kind', 'item') == 'item' || (request.resource.data.quantity == 1 && !('parentId' in request.resource.data)))
          && (!('parentId' in request.resource.data) || (request.resource.data.parentId is string && request.resource.data.parentId.matches('[A-Za-z0-9]{1,40}')))
          && validText(request.resource.data.title, 200)
          && (request.resource.data.description == '' || validText(request.resource.data.description, 2000))
          && number(request.resource.data.quantity, 0.001, 1000000)
          && request.resource.data.unit is string && request.resource.data.unit.size() >= 1 && request.resource.data.unit.size() <= 20
          && number(request.resource.data.unitPrice, 0, 10000000)
          && request.resource.data.order is int
          && validAttachments(pid, 'budget', id)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRole == projectRole(pid)
          && request.resource.data.authorName is string
          && request.resource.data.updatedAt == request.time
          && (resource == null
              ? request.resource.data.createdAt == request.time
              : request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if projectRole(pid) in ['builder', 'cj'] && budgetOpen(pid);
      }

      // Firmas del presupuesto: una del cliente y otra del constructor (el id es el papel).
      // Guardan copia de las líneas firmadas y su huella. No se editan; quien firmó (o CJ) puede
      // retirar su firma solo mientras falte la otra.
      match /signatures/{r} {
        allow read: if inDeal(pid);
        allow create: if r in ['client', 'builder']
          && projectRole(pid) == r
          && request.resource.data.keys().hasOnly(['role', 'uid', 'name', 'accepted', 'image', 'hash', 'lines', 'plan', 'base', 'vatRate', 'idType', 'signedAt'])
          // Antes de firmar, la persona ha subido su DNI, NIE o pasaporte (lo guarda el servidor)
          && exists(/databases/$(database)/documents/projects/$(pid)/identities/$(r))
          && get(/databases/$(database)/documents/projects/$(pid)/identities/$(r)).data.uid == request.auth.uid
          && request.resource.data.idType == get(/databases/$(database)/documents/projects/$(pid)/identities/$(r)).data.docType
          && (!('plan' in request.resource.data) || planOk(request.resource.data.plan))
          && request.resource.data.role == r
          && request.resource.data.uid == request.auth.uid
          && validText(request.resource.data.name, 120)
          && request.resource.data.accepted == true
          && request.resource.data.image is string
          && request.resource.data.image.size() <= 200000
          && request.resource.data.image.matches('data:image/png;base64,[A-Za-z0-9+/=]+')
          && request.resource.data.hash is string && request.resource.data.hash.matches('[0-9a-f]{64}')
          && request.resource.data.lines is list
          && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 200
          && number(request.resource.data.base, 0, 1000000000)
          && request.resource.data.vatRate == project(pid).get('vatRate', 21)
          && request.resource.data.signedAt == request.time;
        allow update: if false;
        allow delete: if r in ['client', 'builder']
          && (projectRole(pid) == r || projectRole(pid) == 'cj')
          && !exists(signaturePath(pid, r == 'client' ? 'builder' : 'client'));
      }

      // Documento de identidad de quien firma (DNI, NIE o pasaporte). Lo escribe solo el servidor
      // (función uploadIdentity) y lo ven CJ y la propia persona; la otra parte, no.
      match /identities/{r} {
        allow get: if projectRole(pid) == 'cj'
          || (r in ['client', 'builder'] && projectRole(pid) == r && (resource == null || resource.data.uid == request.auth.uid));
        allow list: if projectRole(pid) == 'cj';
        allow write: if false;
      }

      // Plan de pagos: lo escriben el constructor o CJ junto con el presupuesto, y se firma con él
      match /plan/main {
        allow read: if inDeal(pid);
        allow create, update: if projectRole(pid) in ['builder', 'cj']
          && budgetOpen(pid)
          && request.resource.data.keys().hasOnly(['milestones', 'authorUid', 'authorRole', 'authorName', 'updatedAt'])
          && planOk(request.resource.data.milestones)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRole == projectRole(pid)
          && request.resource.data.authorName is string
          && request.resource.data.updatedAt == request.time;
        allow delete: if projectRole(pid) in ['builder', 'cj'] && budgetOpen(pid);
      }

      // Liberación del 10 % final: solo el cliente, con el presupuesto firmado, cuando da por buenos los repasos
      match /plan/release {
        allow read: if inDeal(pid);
        allow create: if projectRole(pid) == 'client'
          && exists(signaturePath(pid, 'client')) && exists(signaturePath(pid, 'builder'))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'releasedAt'])
          && request.resource.data.uid == request.auth.uid
          && validText(request.resource.data.name, 120)
          && request.resource.data.releasedAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }

      // Lista de repasos: el cliente o CJ apuntan lo que hay que mejorar (con fotos); el constructor lo marca
      // como arreglado (con fotos); el cliente o CJ lo dan por bueno o lo reabren
      match /snags/{id} {
        allow read: if inDeal(pid);
        allow create: if projectRole(pid) in ['client', 'cj']
          && request.resource.data.keys().hasOnly(['title', 'text', 'attachments', 'status', 'authorUid', 'authorRole', 'authorName', 'createdAt'])
          && validText(request.resource.data.title, 200)
          && (request.resource.data.text == '' || validText(request.resource.data.text, 2000))
          && validAttachments(pid, 'snags', id)
          && request.resource.data.status == 'open'
          && signedBy(projectRole(pid));
        allow update: if (projectRole(pid) == 'builder'
            && resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'fixedByUid', 'fixedByName', 'fixedAt', 'fixNote', 'fixAttachments'])
            && request.resource.data.status == 'fixed'
            && request.resource.data.fixedByUid == request.auth.uid
            && request.resource.data.fixedByName is string
            && request.resource.data.fixedAt == request.time
            && (request.resource.data.get('fixNote', '') == '' || validText(request.resource.data.fixNote, 2000))
            && validFiles('fixAttachments', pid, 'snags', id))
          || (projectRole(pid) in ['client', 'cj']
            && resource.data.status == 'fixed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'okByUid', 'okByName', 'okAt', 'reopenNote'])
            && ((request.resource.data.status == 'ok'
                  && request.resource.data.okByUid == request.auth.uid
                  && request.resource.data.okByName is string
                  && request.resource.data.okAt == request.time)
                || (request.resource.data.status == 'open'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopenNote'])
                  && (request.resource.data.get('reopenNote', '') == '' || validText(request.resource.data.reopenNote, 1000)))));
        allow delete: if isAdmin();
      }

      // Elecciones de productos (en tienda, con el cliente), una vez firmado el presupuesto por los dos:
      // las anotan CJ o el constructor con foto, precio, tienda y referencia. El cliente y el constructor confirman una vez que están conformes. No se editan;
      // solo CJ puede borrar una anotada por error.
      match /selections/{id} {
        allow read: if inDeal(pid);
        allow create: if projectRole(pid) in ['builder', 'cj']
          && exists(signaturePath(pid, 'client')) && exists(signaturePath(pid, 'builder'))
          && request.resource.data.keys().hasOnly(['title', 'store', 'price', 'reference', 'note', 'lineId', 'attachments', 'authorUid', 'authorRole', 'authorName', 'createdAt', 'builderOkUid', 'builderOkName', 'builderOkAt'])
          && validText(request.resource.data.title, 200)
          && validText(request.resource.data.store, 200)
          && money(request.resource.data.price)
          && (request.resource.data.reference == '' || validText(request.resource.data.reference, 200))
          && (request.resource.data.note == '' || validText(request.resource.data.note, 2000))
          && (!('lineId' in request.resource.data) || (request.resource.data.lineId is string && request.resource.data.lineId.matches('[A-Za-z0-9]{1,40}')))
          && validAttachments(pid, 'selections', id)
          && signedBy(projectRole(pid))
          // Si la anota el constructor, queda ya conforme por su parte
          && (!('builderOkUid' in request.resource.data)
              || (projectRole(pid) == 'builder'
                  && request.resource.data.builderOkUid == request.auth.uid
                  && request.resource.data.builderOkName is string
                  && request.resource.data.builderOkAt == request.time));
        allow update: if (projectRole(pid) == 'client'
            && !('clientOkUid' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientOkUid', 'clientOkName', 'clientOkAt'])
            && request.resource.data.clientOkUid == request.auth.uid
            && request.resource.data.clientOkName is string
            && request.resource.data.clientOkAt == request.time)
          || (projectRole(pid) == 'builder'
            && !('builderOkUid' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['builderOkUid', 'builderOkName', 'builderOkAt'])
            && request.resource.data.builderOkUid == request.auth.uid
            && request.resource.data.builderOkName is string
            && request.resource.data.builderOkAt == request.time);
        allow delete: if isAdmin();
      }

      // Extras: los propone el constructor o CJ con precio; solo el cliente los aprueba o rechaza.
      // Quien lo propuso puede retirarlo mientras no se haya decidido.
      match /extras/{id} {
        allow read: if inDeal(pid);
        allow create: if projectRole(pid) in ['builder', 'cj']
          && request.resource.data.keys().hasOnly(['title', 'description', 'amount', 'selectionId', 'proposedByUid', 'proposedByRole', 'proposedByName', 'status', 'createdAt'])
          // Extra por la diferencia de un producto elegido: apunta a esa elección
          && (!('selectionId' in request.resource.data)
              || (request.resource.data.selectionId is string
                  && exists(/databases/$(database)/documents/projects/$(pid)/selections/$(request.resource.data.selectionId))))
          && validText(request.resource.data.title, 200)
          && (request.resource.data.description == '' || validText(request.resource.data.description, 4000))
          && money(request.resource.data.amount)
          && request.resource.data.proposedByUid == request.auth.uid
          && request.resource.data.proposedByRole == projectRole(pid)
          && request.resource.data.proposedByName is string
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if resource.data.status == 'pending'
          && (
            (projectRole(pid) == 'client'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedByUid', 'decidedByName', 'decidedAt', 'decisionNote'])
              && request.resource.data.status in ['approved', 'rejected']
              && request.resource.data.decidedByUid == request.auth.uid
              && request.resource.data.decidedByName is string
              && request.resource.data.decidedAt == request.time
              && (!('decisionNote' in request.resource.data) || request.resource.data.decisionNote == '' || validText(request.resource.data.decisionNote, 1000)))
            || (resource.data.proposedByUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status == 'withdrawn')
          );
        allow delete: if isAdmin();
      }
    }

    // ---------- reforms/{rid}: una reforma (varios contratos de la misma casa) con sus planos ----------
    // La mantiene CJ: quién participa (profesionales y arquitectos o diseñadores) para compartir los planos.
    function reform(rid) {
      return get(/databases/$(database)/documents/reforms/$(rid)).data;
    }

    function inReform(rid) {
      return isAdmin()
        || (isClient() && reform(rid).clientId == me().clientId)
        || (isBuilder() && request.auth.uid in reform(rid).builderUids)
        || (isDesigner() && request.auth.uid in reform(rid).designerUids);
    }

    match /reforms/{rid} {
      allow read: if inReform(rid);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['clientId', 'title', 'builderUids', 'designerUids', 'updatedAt'])
        && request.resource.data.clientId is string
        && validText(request.resource.data.title, 200)
        && request.resource.data.builderUids is list && request.resource.data.builderUids.size() <= 20
        && request.resource.data.designerUids is list && request.resource.data.designerUids.size() <= 10;
      allow delete: if isAdmin();

      // Planos y diseños: los suben CJ y los arquitectos o diseñadores de la reforma; no se editan
      match /plans/{id} {
        allow read: if inReform(rid);
        allow create: if (isAdmin() || (isDesigner() && request.auth.uid in reform(rid).designerUids))
          && request.resource.data.keys().hasOnly(['title', 'kind', 'note', 'attachments', 'authorUid', 'authorRole', 'authorName', 'createdAt'])
          && validText(request.resource.data.title, 200)
          && request.resource.data.kind in ['plan', 'design', 'render', 'other']
          && (request.resource.data.note == '' || validText(request.resource.data.note, 2000))
          && request.resource.data.attachments is list
          && request.resource.data.attachments.size() >= 1 && request.resource.data.attachments.size() <= 6
          && reformFileOk(request.resource.data.attachments[0], rid, id)
          && (request.resource.data.attachments.size() < 2 || reformFileOk(request.resource.data.attachments[1], rid, id))
          && (request.resource.data.attachments.size() < 3 || reformFileOk(request.resource.data.attachments[2], rid, id))
          && (request.resource.data.attachments.size() < 4 || reformFileOk(request.resource.data.attachments[3], rid, id))
          && (request.resource.data.attachments.size() < 5 || reformFileOk(request.resource.data.attachments[4], rid, id))
          && (request.resource.data.attachments.size() < 6 || reformFileOk(request.resource.data.attachments[5], rid, id))
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorRole == (isAdmin() ? 'cj' : 'designer')
          && request.resource.data.authorName is string
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    function reformFileOk(a, rid, id) {
      return a is map
        && a.path is string && a.path.matches('reforms/' + rid + '/plans/' + id + '/.+')
        && a.url is string
        && (a.url.matches('https://firebasestorage[.]googleapis[.]com/.+') || a.url.matches('http://127[.]0[.]0[.]1:9199/.+'));
    }

    // ---------- Todo lo demás: denegado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
